{
    "rewrites": [
        {
            "source": "/api/agents/:agent",
            "destination": "/api/agents-router?agent=:agent"
        },
        {
            "source": "/api/emails/registration",
            "destination": "/api/emails-handler?action=registration"
        },
        {
            "source": "/api/emails/password-reset",
            "destination": "/api/emails-handler?action=password-reset"
        },
        {
            "source": "/privacy",
            "destination": "/privacy.html"
        },
        {
            "source": "/terms",
            "destination": "/terms.html"
        },
        {
            "source": "/blog",
            "destination": "/blog.html"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
